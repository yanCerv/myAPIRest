# Local development only. Do not use these credentials in staging or production.
POSTGRES_USER=api_local_user
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=my_api_rest
POSTGRES_PORT=5432

# This value will be used by Prisma in the next stage.
DATABASE_URL="postgresql://api_local_user:change-this-local-password@localhost:5432/my_api_rest?schema=public"
