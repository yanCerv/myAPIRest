# Local development only. Do not use these credentials in staging or production.
POSTGRES_USER=api_local_user
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=my_api_rest
POSTGRES_PORT=5432

# This value will be used by Prisma in the next stage.
DATABASE_URL="postgresql://api_local_user:change-this-local-password@localhost:5432/my_api_rest?schema=public"

# Generate unique, high-entropy values per environment. Never reuse these examples.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_TTL_SECONDS=900
SESSION_TTL_HOURS=24

# Email delivery. Keep "console" for local development: OTPs are written only to the server log.
EMAIL_PROVIDER=console
# To send through Resend, set EMAIL_PROVIDER=resend and configure both values below.
# RESEND_API_KEY=re_replace-with-your-api-key
# EMAIL_FROM="MyAPIRest <noreply@your-verified-domain.example>"

# Movie catalog provider. Keep this token only on the API server, never in a client app.
TMDB_BASE_URL=https://api.themoviedb.org
# TMDB_READ_ACCESS_TOKEN=replace-with-a-rotated-tmdb-read-access-token
TICKETMASTER_BASE_URL=https://app.ticketmaster.com
# TICKETMASTER_API_KEY=replace-with-a-rotated-ticketmaster-api-key
