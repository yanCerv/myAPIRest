generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(320)
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  sessions     RefreshSession[]
  accountActionTokens AccountActionToken[]
  externalIdentities ExternalIdentity[]
  profile            UserProfile?
  movieFavorites     MovieFavorite[]
  purchases          Purchase[]

  @@map("users")
}

enum PurchaseStatus {
  CONFIRMED
}

enum PaymentMethod {
  VISA
  MASTERCARD
  AMEX
}

enum PaymentStatus {
  APPROVED
}

model Purchase {
  id                   String        @id @default(uuid()) @db.Uuid
  bookingCode          String        @unique @map("booking_code") @db.VarChar(32)
  userId               String        @map("user_id") @db.Uuid
  status               PurchaseStatus @default(CONFIRMED)
  movieId              Int           @map("movie_id")
  movieTitle           String        @map("movie_title") @db.VarChar(500)
  moviePosterPath      String?       @map("movie_poster_path") @db.VarChar(500)
  movieDurationMinutes Int?          @map("movie_duration_minutes")
  movieGenres          String[]      @map("movie_genres")
  showtimeId           String        @map("showtime_id") @db.VarChar(255)
  startsAt             DateTime      @map("starts_at")
  cinema               String        @db.VarChar(255)
  auditorium           String        @db.VarChar(255)
  screenType           String        @map("screen_type") @db.VarChar(255)
  buyerFirstName       String        @map("buyer_first_name") @db.VarChar(100)
  buyerLastName        String        @map("buyer_last_name") @db.VarChar(100)
  buyerEmail           String        @map("buyer_email") @db.VarChar(320)
  paymentMethod        PaymentMethod @map("payment_method")
  paymentLast4         String        @map("payment_last4") @db.VarChar(4)
  paymentStatus        PaymentStatus @default(APPROVED) @map("payment_status")
  totalCents           Int           @map("total_cents")
  currency             String        @db.VarChar(3)
  createdAt            DateTime      @default(now()) @map("created_at")
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  seats                PurchaseSeat[]

  @@index([userId, createdAt])
  @@index([showtimeId])
  @@map("purchases")
}

model PurchaseSeat {
  id         String   @id @default(uuid()) @db.Uuid
  purchaseId String   @map("purchase_id") @db.Uuid
  showtimeId String   @map("showtime_id") @db.VarChar(255)
  seatId     String   @map("seat_id") @db.VarChar(255)
  label      String   @db.VarChar(32)
  type       String   @db.VarChar(32)
  priceCents Int      @map("price_cents")
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@unique([showtimeId, seatId])
  @@index([purchaseId])
  @@map("purchase_seats")
}

model MovieFavorite {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  tmdbMovieId Int      @map("tmdb_movie_id")
  title       String   @db.VarChar(500)
  posterPath  String?  @map("poster_path") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbMovieId])
  @@index([userId, createdAt])
  @@map("movie_favorites")
}

model UserProfile {
  userId    String   @id @map("user_id") @db.Uuid
  firstName String?  @map("first_name") @db.VarChar(100)
  lastName  String?  @map("last_name") @db.VarChar(100)
  avatarUrl String?  @map("avatar_url") @db.Text
  locale    String?  @db.VarChar(35)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

enum ExternalIdentityProvider {
  GOOGLE
  APPLE
}

model ExternalIdentity {
  id             String                   @id @default(uuid()) @db.Uuid
  userId         String                   @map("user_id") @db.Uuid
  provider       ExternalIdentityProvider
  providerUserId String                   @map("provider_user_id") @db.VarChar(255)
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("external_identities")
}

enum AccountActionPurpose {
  RESET_PASSWORD
  RESTORE_ACCOUNT
  LOGIN_OTP
}

model AccountActionToken {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  purpose     AccountActionPurpose
  tokenHash   String               @map("token_hash") @db.VarChar(255)
  expiresAt   DateTime             @map("expires_at")
  consumedAt  DateTime?            @map("consumed_at")
  attempts    Int                  @default(0)
  createdAt   DateTime             @default(now()) @map("created_at")
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("account_action_tokens")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  absoluteExpiresAt DateTime @map("absolute_expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  version   Int       @default(0)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}
