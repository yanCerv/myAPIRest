generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(320)
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  sessions     RefreshSession[]
  accountActionTokens AccountActionToken[]
  externalIdentities ExternalIdentity[]

  @@map("users")
}

enum ExternalIdentityProvider {
  GOOGLE
  APPLE
}

model ExternalIdentity {
  id             String                   @id @default(uuid()) @db.Uuid
  userId         String                   @map("user_id") @db.Uuid
  provider       ExternalIdentityProvider
  providerUserId String                   @map("provider_user_id") @db.VarChar(255)
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("external_identities")
}

enum AccountActionPurpose {
  RESET_PASSWORD
  RESTORE_ACCOUNT
  LOGIN_OTP
}

model AccountActionToken {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  purpose     AccountActionPurpose
  tokenHash   String               @map("token_hash") @db.VarChar(255)
  expiresAt   DateTime             @map("expires_at")
  consumedAt  DateTime?            @map("consumed_at")
  attempts    Int                  @default(0)
  createdAt   DateTime             @default(now()) @map("created_at")
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("account_action_tokens")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  absoluteExpiresAt DateTime @map("absolute_expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  version   Int       @default(0)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}
